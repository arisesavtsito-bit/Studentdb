                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set(\"token\", json.data.token);",
                  "  console.log(\"Token sauvegarde dans la variable {{token}}\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prof@test.mg\",\n  \"motDePasse\": \"motdepasse123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
